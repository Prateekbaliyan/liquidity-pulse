# Environment Configuration
ENV=development
DEFAULT_SYMBOL=BTCUSDT

# Binance WebSocket Stream
BINANCE_WS_BASE_URL=wss://fstream.binance.com/ws

# Database & Cache
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/liquidity_pulse
REDIS_URL=redis://localhost:6379/0

# ML Model Paths
MODEL_PATH=ml_pipeline/artifacts/model.onnx
FEATURE_SCHEMA_PATH=ml_pipeline/artifacts/feature_schema.json
MODEL_METADATA_PATH=ml_pipeline/artifacts/model_metadata.json

# Frontend Configuration
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
